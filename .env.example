# FinanceRPA 顶层环境变量示例
# 复制为 .env 并按需修改
# 各子项目有独立的 .env.example，此文件为全局配置

# ===== 数据库（M0.2 Docker Compose 启用）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finrpa
POSTGRES_USER=finrpa
POSTGRES_PASSWORD=finrpa

# ===== Redis（M0.2 Docker Compose 启用）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 对象存储 MinIO（M0.2 Docker Compose 启用）=====
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=finrpa
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ===== JWT（M1.1 认证模块启用）=====
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRATION=86400

# ===== Java ↔ Python 内部通信 Token（M2.2 启用）=====
AI_INTERNAL_TOKEN=finrpa-internal-secret

# ===== Skyvern 配置（M3.7 启用）=====
# Skyvern JWT 与加密密钥（开发环境用占位符，生产环境务必替换）
SKYVERN_SECRET_KEY=finrpa-skyvern-dev-secret-change-in-prod
SKYVERN_AES_KEY=finrpa-aes-dev-secret-change-in-prod

# ===== 火山方舟 LLM 配置（Skyvern 视觉决策用）=====
# 火山方舟豆包模型，Skyvern 原生支持（ENABLE_VOLCENGINE）
# 获取 API Key：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
# 开通模型：https://console.volcengine.com/ark/region:ark+cn-beijing/openManagement
VOLCENGINE_API_KEY=

# Skyvern LLM 配置 Key（选择豆包模型，需先在火山方舟控制台开通对应模型）
# 可选值：
#   VOLCENGINE_DOUBAO_SEED_EVOLVING         → doubao-seed-evolving（持续演进版，当前已开通）
#   VOLCENGINE_DOUBAO_SEED_1_6              → doubao-seed-1.6-250615（旗舰版）
#   VOLCENGINE_DOUBAO_SEED_1_6_FLASH       → doubao-seed-1.6-flash-250615（快速版）
#   VOLCENGINE_DOUBAO_1_5_THINKING_VISION_PRO → doubao-1-5-thinking-vision-pro-250428（思考版）
SKYVERN_LLM_KEY=VOLCENGINE_DOUBAO_SEED_EVOLVING

# ===== OpenAI API Key（备选，未启用）=====
# 如需切换回 OpenAI，请在 docker-compose.yml 中改 ENABLE_VOLCENGINE=false + ENABLE_OPENAI=true
# OPENAI_API_KEY=

# ===== LLM（M2 AI 模块启用，finance-ai 自有 LLM 调用用）=====
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
