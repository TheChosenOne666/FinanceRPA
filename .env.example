# FinanceRPA 顶层环境变量示例
# 复制为 .env 并按需修改
# 各子项目有独立的 .env.example，此文件为全局配置

# ===== 数据库（M0.2 Docker Compose 启用）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finrpa
POSTGRES_USER=finrpa
POSTGRES_PASSWORD=finrpa

# ===== Redis（M0.2 Docker Compose 启用）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 对象存储 MinIO（M0.2 Docker Compose 启用）=====
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=finrpa

# ===== JWT（M1.1 认证模块启用）=====
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRATION=86400

# ===== LLM（M2 AI 模块启用）=====
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
