{
  "name": "finrpa-perf",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "FinanceRPA M9.2 性能测试：单任务延迟 + 并发吞吐 + SSE 延迟 + 审计百万查询 + LLM 成本基线",
  "scripts": {
    "test": "playwright test",
    "test:single": "playwright test scenarios/01-single-task-latency.spec.ts",
    "test:concurrent": "playwright test scenarios/02-concurrent-throughput.spec.ts",
    "test:sse": "playwright test scenarios/03-sse-latency.spec.ts",
    "test:audit": "playwright test scenarios/04-audit-query-perf.spec.ts",
    "test:llm": "playwright test scenarios/05-llm-cost-baseline.spec.ts",
    "test:concurrent:jmx:50": "jmeter -n -t jmeter/concurrent-mock.jmx -Jconcurrent.level=50 -l jmeter/results-50.jtl -e -o jmeter/report-50",
    "test:concurrent:jmx:100": "jmeter -n -t jmeter/concurrent-mock.jmx -Jconcurrent.level=100 -l jmeter/results-100.jtl -e -o jmeter/report-100",
    "seed:audit": "node scripts/seed-audit-logs.mjs",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "axios": "^1.7.7",
    "eventsource": "^3.0.2",
    "pg": "^8.13.0",
    "typescript": "^5.6.3"
  }
}
