# FinanceRPA 生产环境变量示例
# 复制为 .env.prod 并填入真实密钥：cp .env.prod.example .env.prod
# 启动：docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# 标注 [必填] 的变量未设置时 docker-compose 启动会直接报错（${VAR:?...} 语法）
# 标注 [可选] 的变量未设置时使用默认值

# ===== 数据库（PostgreSQL）=====
POSTGRES_DB=finrpa
POSTGRES_USER=finrpa
# [必填] 数据库密码，建议 ≥ 32 位随机字符串
POSTGRES_PASSWORD=请替换为强随机密码

# ===== Redis =====
# [必填] Redis 密码，建议 ≥ 24 位随机字符串
REDIS_PASSWORD=请替换为强随机密码

# ===== 对象存储 MinIO =====
# [必填] MinIO 管理员用户名（≥ 3 字符）
MINIO_ROOT_USER=finrpa-minio-admin
# [必填] MinIO 管理员密码（≥ 8 字符）
MINIO_ROOT_PASSWORD=请替换为强随机密码
# [可选] MinIO Console 暴露到宿主机的端口（生产建议改为非 9001 或加防火墙白名单）
MINIO_CONSOLE_PORT=9001
# [可选] 审计截图 bucket 前缀，完整 bucket 名为 {prefix}{org_id}
MINIO_BUCKET_PREFIX=finrpa-audit-

# ===== Java ↔ Python 内部通信 Token =====
# [必填] 服务间共享密钥，Java 与 Python 必须一致（X-Internal-Token Header）
AI_INTERNAL_TOKEN=请替换为强随机字符串

# ===== JWT 密钥（Java 后端用户认证）=====
# [必填] JWT 签名密钥，建议 ≥ 64 字节随机字符串
JWT_SECRET=请替换为强随机字符串至少64字节

# ===== Fernet 加密密钥（工作流敏感参数加密）=====
# [必填] 32 字节密钥的 Base64url 编码
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：开发环境与生产环境密钥不同会导致已有工作流模板敏感参数解密失败
FERNET_KEY=请替换为Fernet生成的密钥

# ===== Skyvern 密钥 =====
# [必填] Skyvern JWT 密钥
SKYVERN_SECRET_KEY=请替换为强随机字符串
# [必填] Skyvern AES 加密密钥
SKYVERN_AES_KEY=请替换为强随机字符串

# ===== 火山方舟 LLM 配置（Skyvern 视觉决策 + risk_judge 用）=====
# [必填] 火山方舟 API Key
# 获取：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
VOLCENGINE_API_KEY=请填入火山方舟APIKey
# [可选] Skyvern 内部 LLM Key，可选值：
#   VOLCENGINE_DOUBAO_SEED_EVOLVING         → doubao-seed-evolving（持续演进版）
#   VOLCENGINE_DOUBAO_SEED_1_6              → doubao-seed-1.6-250615（旗舰版，默认）
#   VOLCENGINE_DOUBAO_SEED_1_6_FLASH       → doubao-seed-1.6-flash-250615（快速版）
SKYVERN_LLM_KEY=VOLCENGINE_DOUBAO_SEED_1_6

# ===== CORS 允许来源 =====
# [可选] Skyvern 允许的前端来源（JSON 数组字符串），生产建议改为具体域名
# 示例：["https://finrpa.example.com"]
ALLOWED_ORIGINS=["https://localhost"]

# ===== 执行器配置（finance-ai）=====
# [可选] 最大并发任务数（M9.2 测试：5 并发真实 Skyvern 资源占用合理）
EXECUTOR_MAX_CONCURRENT=5
# [可选] 单步执行超时（秒）
EXECUTOR_STEP_TIMEOUT=60

# ===== 通知模块（可选，未配置则跳过）=====
# [可选] 企业微信群机器人 Webhook URL
WECOM_WEBHOOK_URL=
# [可选] 钉钉群机器人 Webhook URL
DINGTALK_WEBHOOK_URL=
# [可选] 钉钉加签密钥（启用加签模式时必填）
DINGTALK_SECRET=
