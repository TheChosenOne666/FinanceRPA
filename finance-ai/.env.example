# FinanceRPA AI 服务环境变量示例
# 复制为 .env 并按需修改

# 服务配置
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Java 后端地址
BACKEND_BASE_URL=http://localhost:8080

# 数据库（M0.2 启用）
DATABASE_URL=postgresql+asyncpg://finrpa:finrpa@localhost:5432/finrpa

# Redis（M0.2 启用）
REDIS_URL=redis://localhost:6379/1

# LLM 配置（M2 启用）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
