# FinanceRPA AI 服务环境变量示例
# 复制为 .env 并按需修改

# ========== 服务配置 ==========
DEBUG=false
HOST=0.0.0.0
PORT=8000
ENV=local

# Java 后端地址
BACKEND_BASE_URL=http://localhost:8080

# ========== 数据库 ==========
# finance-ai 自己的数据库（用于 Planner/Executor 等业务表）
DATABASE_URL=postgresql+asyncpg://finrpa:finrpa@localhost:5432/finrpa

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/1

# ========== finance-ai 自有 LLM 配置（Planner 等用） ==========
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ========== 内部鉴权 ==========
# 服务间通信，需与 Java 后端 ai.internal-token 一致
INTERNAL_API_TOKEN=finrpa-internal-secret

# ========== 执行器配置 ==========
EXECUTOR_MAX_CONCURRENT=5
EXECUTOR_STEP_TIMEOUT=60

# ========== Skyvern 配置（M3.7 引入） ==========
# 数据库：共用 finrpa 库（M3.7 决策），Skyvern alembic 建 skyvern 自己的表与 finrpa 表共存
DATABASE_STRING=postgresql+asyncpg://finrpa:finrpa@localhost:5432/finrpa

# 浏览器：headless 模式（容器内无显示）
BROWSER_TYPE=chromium-headless

# Skyvern 数据目录（视频、HAR、日志、截图等产物）
VIDEO_PATH=/data/videos
HAR_PATH=/data/har
LOG_PATH=/data/log
ARTIFACT_STORAGE_PATH=/data/artifacts

# 存储类型：local（不使用 S3/Azure）
SKYVERN_STORAGE_TYPE=local

# 通知注册类型：local（不使用 Redis 通知）
NOTIFICATION_REGISTRY_TYPE=local

# 凭证库类型：bitwarden（默认，但 M3.7 不配置 Bitwarden 凭证，不使用凭证功能）
CREDENTIAL_VAULT_TYPE=bitwarden

# Skyvern 环境标识
EXECUTE_ALL_STEPS=true
ALLOWED_ORIGINS=["*"]

# JWT 密钥（生产环境务必替换）
SECRET_KEY=finrpa-skyvern-dev-secret-change-in-prod

# 加密密钥（生产环境务必替换）
ENCRYPTOR_AES_SECRET_KEY=finrpa-aes-dev-secret-change-in-prod

# ========== Skyvern LLM 配置（视觉决策用，必填） ==========
# 启用 OpenAI 提供商
ENABLE_OPENAI=true
# LLM 模型 key（Skyvern 内部模型名，对应 OPENAI_GPT4O）
LLM_KEY=OPENAI_GPT4O
# OpenAI API Key（必填，否则 Skyvern 无法执行视觉决策）
OPENAI_API_KEY=

# 如需使用 OpenAI 兼容 API（如 DeepSeek、智谱、通义千问等），改用以下配置：
# ENABLE_OPENAI=false
# ENABLE_OPENAI_COMPATIBLE=true
# OPENAI_COMPATIBLE_MODEL_NAME=your-model-name
# OPENAI_COMPATIBLE_API_KEY=your-api-key
# OPENAI_COMPATIBLE_API_BASE=https://your-api-base/v1
# OPENAI_COMPATIBLE_SUPPORTS_VISION=true
# LLM_KEY=OPENAI_COMPATIBLE
